ASSEMBLYAI_API_KEY=
PORT=8787

# Optional: Clerk (@clerk/express) sign-in so each public-demo visitor gets their own
# trial. Leave both unset for local dev/CI - the app runs exactly as before, no accounts.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Optional: comma-separated, case-insensitive emails allowed to use the QualEval operator
# controls (Settings > Target agents, Phone Evals). Unset = nobody. Matched against the
# signed-in Clerk user's verified emails. Exactly "*" opens them to everyone (the only way
# in with Clerk off); a "*" mixed into an email list is ignored.
QUALEVAL_OPERATOR_EMAILS=sujeevraja26@gmail.com,sai.9500@gmail.com
