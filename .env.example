ASSEMBLYAI_API_KEY=
PORT=8787

# Optional: Clerk (@clerk/express) sign-in so each public-demo visitor gets their own
# trial. Leave both unset for local dev/CI - the app runs exactly as before, no accounts.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Optional: comma-separated, case-insensitive emails allowed to use deployment operator
# controls (Settings > Target agents, provider registry). Unset = nobody. Admins below
# are also treated as operators. Exactly "*" opens them to everyone (the only way in
# with Clerk off); a "*" mixed into an email list is ignored.
QUALEVAL_OPERATOR_EMAILS=
# Optional: comma-separated admin emails for Phone Evals. Admins see every call and can
# open Phone Evals without importing a Twilio number. Other signed-in users need a number
# in Settings and only see calls to numbers they registered.
QUALEVAL_ADMIN_EMAILS=sujeevraja26@gmail.com,sai.9500@gmail.com
