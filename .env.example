ASSEMBLYAI_API_KEY=
PORT=8787

# Optional: Clerk (@clerk/express) sign-in so each public-demo visitor gets their own
# trial. Leave both unset for local dev/CI - the app runs exactly as before, no accounts.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Optional: comma-separated, case-insensitive emails allowed to use the QualEval Settings
# page (switch the live demo agent, read its prompts). Unset = nobody. Matched against the
# signed-in Clerk user's verified emails; with Clerk off only "*" (everyone) opens it.
QUALEVAL_OPERATOR_EMAILS=
